# Copy to .env for local development. On Render, set these in the dashboard.

# Required ─────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/noktura
JWT_SECRET=                       # 64 random hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Recommended in production ─────────────────────────────
NODE_ENV=production
PUBLIC_URL=https://noktura.app    # used for PayPal return URLs
SUPPORT_EMAIL=support@noktura.app
CONTACT_EMAIL=hello@noktura.app   # sent to OpenStreetMap in the geocoder User-Agent
ADMIN_HANDLES=                    # comma-separated handles that get the moderation queue

# Payments (PayPal REST app: developer.paypal.com → Apps & Credentials) ──
PAYPAL_ENV=sandbox                # switch to "live" when you go live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PLATFORM_FEE_PCT=5                # service fee on tickets and market sales
MAX_TRANSFER=2000                 # NKT per payment
DAILY_OUT_LIMIT=5000              # NKT sent/withdrawn per 24 h
CONFIRM_PASSWORD_ABOVE=300        # password prompt for payments at or above this
PROMO_PRICE_POST=2                # NKT per day
PROMO_PRICE_PIN=2
PROMO_PRICE_LISTING=1.5
PROMO_PRICE_EVENT=5

# Listings & maps ───────────────────────────────────────
TICKETMASTER_API_KEY=             # free key at developer.ticketmaster.com — live events in any city
TILE_URL=                         # default: CARTO dark/light basemaps; {theme} becomes dark|light
TILE_ATTRIBUTION=
GEOCODING=on                      # "off" disables venue geocoding through OpenStreetMap
SEED_LISTINGS=true                # imports the bundled launch listings on first boot

# Scale ─────────────────────────────────────────────────
DATABASE_POOL_SIZE=15
REDIS_URL=                        # set to run more than one instance (Socket.IO adapter)
API_RATE_PER_MIN=600              # per-IP ceiling across the API
TRUST_PROXY_HOPS=1
ICE_SERVERS=                      # JSON array of STUN/TURN servers for calls, e.g. [{"urls":"turn:turn.example.com","username":"u","credential":"p"}]
